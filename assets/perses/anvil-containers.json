{
  "kind": "Dashboard",
  "metadata": {
    "name": "anvil-containers",
    "project": "default",
    "version": 0
  },
  "spec": {
    "display": {
      "name": "anvil: containers"
    },
    "duration": "6h",
    "refreshInterval": "1m",
    "variables": [],
    "datasources": {},
    "panels": {
      "p00": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Containers running",
            "description": "Long-running containers (system.slice); CI sandboxes are on the CI dashboard"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#5794f2",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "promql-default"
                    },
                    "query": "count(host_cgroup_memory_current_bytes{cgroup=~\"system\\\\.slice/docker-.*\\\\.scope\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "p01": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container CPU",
            "description": "All containers, cores"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 2
              },
              "thresholds": {
                "defaultColor": "#5794f2",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "promql-default"
                    },
                    "query": "sum(rate(host_cgroup_cpu_usage_seconds_total{cgroup=~\"system\\\\.slice/docker-.*\\\\.scope\"}[5m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "p02": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container memory (without file cache)"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "bytes",
                "decimalPlaces": 1
              },
              "thresholds": {
                "defaultColor": "#5794f2",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "promql-default"
                    },
                    "query": "sum(host_cgroup_memory_anon_bytes{cgroup=~\"system\\\\.slice/docker-.*\\\\.scope\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "p03": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Log lines (1h)"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#5794f2",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT count(*) FROM public.vector_logs WHERE \"CONTAINER_NAME\" IS NOT NULL AND greptime_timestamp > now() - INTERVAL '1 hour'"
                  }
                }
              }
            }
          ]
        }
      },
      "p04": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Error lines (24h)",
            "description": "Container lines with journald priority 0-3"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#56a64b",
                "steps": [
                  {
                    "value": 1,
                    "color": "#f2b84b"
                  },
                  {
                    "value": 50,
                    "color": "#e0525e"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT count(*) FROM public.vector_logs WHERE \"CONTAINER_NAME\" IS NOT NULL AND \"PRIORITY\" IN ('0','1','2','3') AND greptime_timestamp > now() - INTERVAL '24 hours'"
                  }
                }
              }
            }
          ]
        }
      },
      "p05": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory (largest container) (without file cache)"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "bytes",
                "decimalPlaces": 1
              },
              "thresholds": {
                "defaultColor": "#5794f2",
                "steps": []
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "promql-default"
                    },
                    "query": "max(host_cgroup_memory_anon_bytes{cgroup=~\"system\\\\.slice/docker-.*\\\\.scope\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "p06": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU per container",
            "description": "Cores, 5-minute average; by container name"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "mean",
                  "max",
                  "last-number"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 3
                },
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.15,
                "connectNulls": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT c.greptime_timestamp, n.name AS container, sum(c.v) AS v FROM (SELECT greptime_timestamp, cgroup, (max(greptime_value) RANGE '5m' - min(greptime_value) RANGE '5m') / 300 AS v FROM public.host_cgroup_cpu_usage_seconds_total WHERE cgroup LIKE 'system.slice/docker-%.scope' AND cgroup NOT LIKE 'system.slice/docker-%/%' AND greptime_timestamp >= to_timestamp_millis(${__from}) AND greptime_timestamp <= to_timestamp_millis(${__to}) ALIGN '2m' BY (cgroup)) c JOIN (SELECT DISTINCT \"CONTAINER_ID_FULL\" AS id, \"CONTAINER_NAME\" AS name FROM public.vector_logs WHERE \"CONTAINER_ID_FULL\" IS NOT NULL) n ON c.cgroup = 'system.slice/docker-' || n.id || '.scope' GROUP BY c.greptime_timestamp, n.name ORDER BY c.greptime_timestamp ASC LIMIT 20000;"
                  }
                }
              }
            }
          ]
        }
      },
      "p07": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory per container (without file cache)",
            "description": "By container name"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "mean",
                  "max",
                  "last-number"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 1
                },
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.15,
                "connectNulls": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT c.greptime_timestamp, n.name AS container, sum(c.v) AS v FROM (SELECT greptime_timestamp, cgroup, max(greptime_value) RANGE '2m' AS v FROM public.host_cgroup_memory_anon_bytes WHERE cgroup LIKE 'system.slice/docker-%.scope' AND cgroup NOT LIKE 'system.slice/docker-%/%' AND greptime_timestamp >= to_timestamp_millis(${__from}) AND greptime_timestamp <= to_timestamp_millis(${__to}) ALIGN '2m' BY (cgroup)) c JOIN (SELECT DISTINCT \"CONTAINER_ID_FULL\" AS id, \"CONTAINER_NAME\" AS name FROM public.vector_logs WHERE \"CONTAINER_ID_FULL\" IS NOT NULL) n ON c.cgroup = 'system.slice/docker-' || n.id || '.scope' GROUP BY c.greptime_timestamp, n.name ORDER BY c.greptime_timestamp ASC LIMIT 20000;"
                  }
                }
              }
            }
          ]
        }
      },
      "p08": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU per container ID",
            "description": "One line per container instance; an id without a name never logged one"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "mean",
                  "max",
                  "last-number"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 3
                },
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.15,
                "connectNulls": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT c.greptime_timestamp, COALESCE(n.name || ' \u00b7 ' || substr(c.cgroup, 21, 12), substr(c.cgroup, 21, 12)) AS container_id, c.v FROM (SELECT greptime_timestamp, cgroup, (max(greptime_value) RANGE '5m' - min(greptime_value) RANGE '5m') / 300 AS v FROM public.host_cgroup_cpu_usage_seconds_total WHERE cgroup LIKE 'system.slice/docker-%.scope' AND cgroup NOT LIKE 'system.slice/docker-%/%' AND greptime_timestamp >= to_timestamp_millis(${__from}) AND greptime_timestamp <= to_timestamp_millis(${__to}) ALIGN '2m' BY (cgroup)) c LEFT JOIN (SELECT DISTINCT \"CONTAINER_ID_FULL\" AS id, \"CONTAINER_NAME\" AS name FROM public.vector_logs WHERE \"CONTAINER_ID_FULL\" IS NOT NULL) n ON c.cgroup = 'system.slice/docker-' || n.id || '.scope' ORDER BY c.greptime_timestamp ASC LIMIT 20000;"
                  }
                }
              }
            }
          ]
        }
      },
      "p09": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory per container ID (without file cache)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "mean",
                  "max",
                  "last-number"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 1
                },
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.15,
                "connectNulls": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT c.greptime_timestamp, COALESCE(n.name || ' \u00b7 ' || substr(c.cgroup, 21, 12), substr(c.cgroup, 21, 12)) AS container_id, c.v FROM (SELECT greptime_timestamp, cgroup, max(greptime_value) RANGE '2m' AS v FROM public.host_cgroup_memory_anon_bytes WHERE cgroup LIKE 'system.slice/docker-%.scope' AND cgroup NOT LIKE 'system.slice/docker-%/%' AND greptime_timestamp >= to_timestamp_millis(${__from}) AND greptime_timestamp <= to_timestamp_millis(${__to}) ALIGN '2m' BY (cgroup)) c LEFT JOIN (SELECT DISTINCT \"CONTAINER_ID_FULL\" AS id, \"CONTAINER_NAME\" AS name FROM public.vector_logs WHERE \"CONTAINER_ID_FULL\" IS NOT NULL) n ON c.cgroup = 'system.slice/docker-' || n.id || '.scope' ORDER BY c.greptime_timestamp ASC LIMIT 20000;"
                  }
                }
              }
            }
          ]
        }
      },
      "p10": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Log lines per container",
            "description": "Per 5 minutes"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "mean",
                  "max",
                  "last-number"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 0
                },
                "min": 0
              },
              "visual": {
                "display": "bar",
                "lineWidth": 1.5,
                "areaOpacity": 0.15,
                "connectNulls": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT greptime_timestamp, \"CONTAINER_NAME\", count(message) RANGE '5m' AS lines FROM public.vector_logs WHERE \"CONTAINER_NAME\" IS NOT NULL AND greptime_timestamp >= to_timestamp_millis(${__from}) AND greptime_timestamp <= to_timestamp_millis(${__to}) ALIGN '5m' BY (\"CONTAINER_NAME\") ORDER BY greptime_timestamp ASC LIMIT 5000;"
                  }
                }
              }
            }
          ]
        }
      },
      "p11": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container log lines",
            "description": "journald log driver"
          },
          "plugin": {
            "kind": "LogsTable",
            "spec": {
              "showTime": true,
              "allowWrap": true,
              "enableDetails": true
            }
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBLogQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "sql-default"
                    },
                    "query": "SELECT greptime_timestamp, \"CONTAINER_NAME\", \"PRIORITY\", message FROM public.vector_logs WHERE \"CONTAINER_NAME\" IS NOT NULL AND greptime_timestamp >= to_timestamp_millis(${__from}) AND greptime_timestamp <= to_timestamp_millis(${__to}) ORDER BY greptime_timestamp DESC LIMIT 500;"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Overview",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p00"
              }
            },
            {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p01"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p02"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 4,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p03"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 4,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p04"
              }
            },
            {
              "x": 20,
              "y": 0,
              "width": 4,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/p05"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Resources per container",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/p06"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/p07"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Resources per container ID",
            "collapse": {
              "open": false
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/p08"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/p09"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Logs",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/p10"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 24,
              "height": 12,
              "content": {
                "$ref": "#/spec/panels/p11"
              }
            }
          ]
        }
      }
    ]
  }
}
